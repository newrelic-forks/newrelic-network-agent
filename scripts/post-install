if [ -d "/etc/newrelic-network-agent/profiles" ]
then
  su -s /bin/bash newrelic-network-agent -c "cd /etc/newrelic-network-agent/profiles && git pull --rebase"
else
  su -s /bin/bash newrelic-network-agent -c "git clone https://github.com/kentik/snmp-profiles.git /etc/newrelic-network-agent/profiles"
fi